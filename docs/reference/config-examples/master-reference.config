# ═══════════════════════════════════════════════════════════════
# NexusMiner TOML Configuration - Master Reference
# Complete documentation of all available configuration options
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# WALLET CONNECTION
# ───────────────────────────────────────────────────────────────
[wallet]
# IP address of your Nexus wallet/node
# Use "127.0.0.1" for local mining
# Use your node's IP for remote mining
ip = "127.0.0.1"

# Port for miner connection (default: 8323)
# This is the "miningport" setting in your nexus.conf
port = 8323

# ───────────────────────────────────────────────────────────────
# NETWORK CONFIGURATION
# ───────────────────────────────────────────────────────────────
[network]
# Local IP address to bind to
# "0.0.0.0" = all network interfaces (recommended)
# "127.0.0.1" = localhost only
local_ip = "0.0.0.0"

# Keepalive interval in hours (1-168 hours)
# How often to send keepalive pings to maintain session
# Default: 24 (once per day)
keepalive_interval = 24

# ───────────────────────────────────────────────────────────────
# MINING CONFIGURATION
# ───────────────────────────────────────────────────────────────
[mining]
# Mining channel selection:
# 1 = Prime channel (CPU mining)
# 2 = Hash channel (GPU/FPGA mining)
channel = 2

# Tritium Genesis Hash (required for Falcon authentication)
# This is your account's genesis hash from your Nexus wallet
# Get it with: system/get/info (in your wallet API)
# Must be exactly 64 hex characters (32 bytes)
genesis = "a174011c93ca1c80bca5388382b167cacd33d3154395ea8f45ac99a8308cd122"

# Reward Address (required for stateless mining)
# Your NXS account address where mining rewards will be sent
# Get your genesis hash with: system/get/info (genesis field)
# Should be a base58-encoded address (~50 characters)
reward_address = "YOUR_GENESIS_HASH_HERE"  # 64-char hex genesis hash from system/get/info (same as genesis above; NOT a Base58 account address)

# ───────────────────────────────────────────────────────────────
# FALCON AUTHENTICATION (REQUIRED)
# ───────────────────────────────────────────────────────────────
[falcon]
# Falcon-512 public key (897 bytes hex = 1794 hex chars)
# Generate with: ./NexusMiner --create-keys
pubkey = "<YOUR_897_BYTE_FALCON_PUBLIC_KEY_HEX>"

# Falcon-512 private key (1281 bytes hex = 2562 hex chars)
# ⚠️ KEEP SECRET! Never share or commit to version control
privkey = "<YOUR_1281_BYTE_FALCON_PRIVATE_KEY_HEX>"

# REQUIRED: enables block signing (safe, upstream-compatible)
enable_disposable_falcon = true

# ───────────────────────────────────────────────────────────────
# WORKER CONFIGURATION
# ───────────────────────────────────────────────────────────────
[workers]
# Number of mining workers to create
# For Prime (CPU): typically number of CPU cores
# For Hash (GPU): typically number of GPUs
count = 8

# ───────────────────────────────────────────────────────────────
# CPU MINING SETTINGS (for Prime channel)
# ───────────────────────────────────────────────────────────────
[cpu]
# Threads per worker
# Recommended: 1 thread per worker for best performance
# Higher values may improve throughput on some CPUs
threads = 1

# Use efficiency cores on Intel hybrid CPUs (Alder Lake, Raptor Lake)
# true = use E-cores for mining (default)
# false = disable E-cores (use P-cores only)
efficiency_cores = true

# Thread priority level (0-4)
# 0 = low
# 1 = below_normal
# 2 = normal (default)
# 3 = above_normal
# 4 = high
priority = 2

# CPU power limit percentage (50-100)
# Controls power consumption and thermal output
# Default: 100 (no limit)
power_limit_percent = 100

# Enable hyperthreading/SMT
# true = use all logical cores (default)
# false = use physical cores only
hyperthreading = true

# Target hashrate (0 = max)
# Set to a specific value to limit hashrate
# Default: 0 (maximum performance)
target_hashrate = 0

# ───────────────────────────────────────────────────────────────
# GPU MINING SETTINGS (for Hash channel)
# ───────────────────────────────────────────────────────────────
[gpu]
# GPU device index
# Set which GPU device to use (default: 0)
# For multiple GPUs, use JSON .conf files
device = 0

# ───────────────────────────────────────────────────────────────
# STATISTICS OUTPUT
# ───────────────────────────────────────────────────────────────
[stats]
# Statistics output mode
# "console" = print to console
# "file" = save to file
mode = "console"

# ───────────────────────────────────────────────────────────────
# LOGGING CONFIGURATION
# ───────────────────────────────────────────────────────────────
[logging]
# Log verbosity level:
# 0 = off (no logging)
# 1 = error (errors only)
# 2 = info (normal operation, recommended)
# 3 = debug (detailed diagnostics)
level = 2

# Log file path (optional)
# Empty = console output only
# Example: "./nexusminer.log" or "/var/log/nexusminer.log"
file = ""

# ───────────────────────────────────────────────────────────────
# ADVANCED TIMING SETTINGS
# ───────────────────────────────────────────────────────────────
[advanced]
# Seconds to wait before retrying failed connection (1-300)
# Default: 5
connection_retry_interval = 5

# Interval in seconds to print statistics (1-3600)
# Default: 30
print_statistics_interval = 30

# Ping interval in seconds (deprecated for solo mining)
# Default: 10
ping_interval = 10

# Height check interval in seconds (deprecated in Phase 2)
# Default: 2
get_height_interval = 2

# Enable ChaCha20-Poly1305 encryption for Falcon pubkey
# Auto-enabled for remote mining (non-localhost)
# Default: false (auto-detect)
enable_chacha20_wrapping = false

# ───────────────────────────────────────────────────────────────
# TLS/SSL ENCRYPTION (for remote mining)
# ───────────────────────────────────────────────────────────────
[tls]
# Enable TLS/SSL for encrypted connections
# Auto-detected for remote mining (non-localhost)
# Default: false (auto-detect)
enable = false

# Path to CA certificate bundle file
# Empty = use system default CA certificates
# Example: "/etc/ssl/certs/ca-certificates.crt"
ca_cert_path = ""

# Verify peer TLS certificate
# ⚠️ Only disable for testing! Production should verify.
# Default: true
verify_peer = true

# Server Name Indication for TLS handshake
# Empty = use wallet_ip value
# Default: ""
server_name = ""

# Path to client certificate file (PEM format) for mutual TLS
# Example: "/path/to/client-cert.pem"
client_cert_path = ""

# Path to client private key file (PEM format)
# Example: "/path/to/client-key.pem"
client_key_path = ""

# Password for encrypted client key (optional)
# Leave empty if key is not password-protected
client_key_password = ""

# ═══════════════════════════════════════════════════════════════
# NOTES
# ═══════════════════════════════════════════════════════════════
#
# 1. GETTING STARTED:
#    - Generate Falcon keys: ./NexusMiner --create-keys
#    - Get genesis hash from wallet: system/get/info
#    - Get genesis hash from wallet: system/get/info → genesis field
#
# 2. PRIME vs HASH:
#    - Prime channel (1): CPU mining, higher difficulty, higher rewards
#    - Hash channel (2): GPU/FPGA mining, lower difficulty
#
# 3. WORKER COUNT:
#    - CPU (Prime): Start with number of physical cores
#    - GPU (Hash): Set to number of GPUs
#    - For JSON-style worker config, use .conf files
#
# 4. PERFORMANCE TIPS:
#    - Use 1 thread per worker for Prime mining
#    - Disable efficiency cores on hybrid CPUs if unstable
#    - Monitor temps and adjust worker count if needed
#
# 5. REMOTE MINING:
#    - Set wallet.ip to your node's IP address
#    - Ensure port 8323 is open on your node
#    - TLS encryption is auto-enabled for remote connections
#
# 6. ADVANCED OPTIONS:
#    - Most users should use default timing settings
#    - ChaCha20 and TLS settings are auto-detected
#    - Falcon keys are REQUIRED for all mining
#
# ═══════════════════════════════════════════════════════════════
