# =============================================================================
# NexusMiner MASTER REFERENCE Configuration
# =============================================================================
# This file illustrates advanced TOML-style options; see the parser and
# configuration reference for the complete and current set of options.
# DO NOT run this file directly — it contains placeholder values.
# Copy a specific config from this directory instead.
#
# Format: .config files use TOML-style syntax
#   [section]     Section header
#   key = value   Key-value pair (string, integer, or boolean)
#   # comment     Line comment
# =============================================================================

# -----------------------------------------------------------------------------
# [wallet] — Node connection settings
# -----------------------------------------------------------------------------
[wallet]
ip = "127.0.0.1"           # Node IP address. Use 127.0.0.1 for localhost,
                            # or a remote IP for a dedicated node.
port = 8323                 # Mining port.
                            #   8323 = legacy lane (default), 9323 = stateless
                            #   Both lanes can carry either mining channel.

# -----------------------------------------------------------------------------
# [mining] — What and where to mine
# -----------------------------------------------------------------------------
[mining]
channel = 1                 # Mining channel:
                            #   1 = Prime (CPU/GPU sieve-based)
                            #   2 = Hash  (GPU/CPU Skein-Keccak)
genesis = "YOUR_GENESIS_HASH_HERE"
                            # 64 hex characters. Get from: system/get/info
                            # This is your Tritium account genesis hash.
reward_address = "YOUR_GENESIS_HASH_HERE"
                            # 64-char hex genesis hash from system/get/info
                            # (same as genesis above; NOT a Base58 account address)

# -----------------------------------------------------------------------------
# [network] — Network and session settings
# -----------------------------------------------------------------------------
[network]
local_ip = "127.0.0.1"     # Local bind address.
                            #   127.0.0.1 = localhost only (use for same-machine node)
                            #   0.0.0.0   = bind to all interfaces (remote/VPN nodes)
                            #   "auto"    = localhost for a local node, otherwise
                            #               bind to all interfaces
keepalive_interval = 24     # Session keepalive ping interval in HOURS.
                            # Valid range: 1–168 (1 hour to 1 week).
                            # This controls how often SESSION_KEEPALIVE packets
                            # are sent to prevent session cache eviction.
                            # - Production/active miners: 1 hour recommended
                            # - Always-on stable miners: 24 hours (default)
                            # - Highly stable connections: up to 168 hours (7 days)
                            # Note: A 10-second early keepalive is always sent
                            # immediately after session establishment (not configurable).
                            # Default: 24 hours (conservative).

# -----------------------------------------------------------------------------
# [workers] — Worker count and hardware type
# -----------------------------------------------------------------------------
[workers]
count = 4                   # Number of mining workers to spawn.
                            # For CPU prime: match your physical core count.
                            # For GPU hash: one per GPU; indices are consecutive
                            # starting at [gpu] device.
hardware = "cpu"            # Worker hardware type:
                            #   "cpu" = Create CPU workers (default)
                            #   "gpu" = Create GPU workers
                            # A later [gpu] device entry also selects GPU.

# -----------------------------------------------------------------------------
# [cpu] — CPU worker settings
# Applied to all workers when hardware = cpu (channel=1 prime or channel=2 hash)
# -----------------------------------------------------------------------------
[cpu]
threads = 1                 # Threads per worker.
                            #   Prime mining: 1 recommended (sieve is single-threaded)
                            #   Hash mining:  set to core count for parallelism
efficiency_cores = true     # Include efficiency cores (E-cores) on hybrid CPUs
                            # (Intel 12th gen+, ARM big.LITTLE).
                            # false = P-cores only for maximum single-thread perf.
hyperthreading = true       # Include SMT/HT logical cores.
                            # false = physical cores only.
priority = 2                # Thread scheduling priority:
                            #   0 = Low
                            #   1 = Below normal
                            #   2 = Normal (default)
                            #   3 = Above normal
                            #   4 = High
power_limit_percent = 100   # Parsed but not enforced by the current workers.
target_hashrate = 0         # Parsed but not enforced by the current workers.

# -----------------------------------------------------------------------------
# [gpu] — GPU worker settings
# Applied when workers are GPU-type (typically channel=2 hash or GPU prime)
# -----------------------------------------------------------------------------
[gpu]
device = 0                  # GPU device index (0 = first GPU, 1 = second, etc.)
                            # count workers use consecutive device indices.
                            # A device entry selects GPU workers, including in
                            # this reference file; do not run it directly.

# -----------------------------------------------------------------------------
# [stats] — Statistics output
# -----------------------------------------------------------------------------
[stats]
mode = "console"            # TOML supports console; file mode is not implemented

# -----------------------------------------------------------------------------
# [logging] — Logging verbosity
# -----------------------------------------------------------------------------
[logging]
level = 2                   # Log verbosity level:
                            #   0 = Trace
                            #   1 = Debug
                            #   2 = Info (recommended for production)
                            #   3 = Warning
file = "miner.log"          # Log file path (optional, logs to file when set)

# -----------------------------------------------------------------------------
# [advanced] — Timing and connection tuning (optional, defaults shown)
# -----------------------------------------------------------------------------
[advanced]
connection_retry_interval = 5    # Seconds between reconnect attempts (default: 5)
print_statistics_interval = 15   # Seconds between stats prints (default: 15)
ping_interval = 10               # Seconds between keepalive pings (default: 10)
get_height_interval = 2          # Seconds between height checks (default: 2)
enable_chacha20_wrapping = false # DEPRECATED — ChaCha20 is ALWAYS ON — not configurable
                                  # (This key is ignored; ChaCha20 wrapping is a core security feature)

# -----------------------------------------------------------------------------
# [falcon] — Falcon authentication (required for SOLO mining)
# Generate your keypair with: ./NexusMiner --create-keys
# Then add the output pubkey/privkey hex strings below.
# SECURITY: chmod 600 this config file to protect your private key.
# -----------------------------------------------------------------------------
[falcon]
# Falcon public key (hex). Generate with: ./NexusMiner --create-keys
pubkey = "YOUR_FALCON_PUBKEY_HEX_HERE"
# Falcon private key (hex). KEEP THIS SECRET. chmod 600 this file.
privkey = "YOUR_FALCON_PRIVKEY_HEX_HERE"
# REQUIRED: enables block signing (safe, upstream-compatible)
# This should always be true for normal operation.
enable_disposable_falcon = true

# -----------------------------------------------------------------------------
# [tls] — TLS/SSL encrypted connection settings
# Historical configuration fields only: the current mining connection does
# not use these settings and does not establish TLS. Use a secure tunnel for
# remote mining. Do not rely on these options to encrypt your connection.
# -----------------------------------------------------------------------------
[tls]
enable_tls = false          # Parsed, but not used by the mining connection
ssl_port = 0                # Parsed, but not used by the mining connection
tls_ca_cert_path = ""       # Path to CA certificate bundle (PEM). Empty = system CAs.
                            # Example: "/etc/ssl/certs/ca-certificates.crt"
tls_verify_peer = true      # Verify node TLS certificate (ALWAYS keep true in production).
                            # Only disable for self-signed certs during local testing.
tls_server_name = ""        # Server Name Indication (SNI). Empty = use wallet.ip.
                            # Set this when the node cert CN differs from wallet.ip.

# --- Mutual TLS fields (also not used by the mining connection) ---
tls_client_cert_path = ""   # Path to client certificate (PEM). Empty = no mTLS.
tls_client_key_path  = ""   # Path to client private key (PEM). SECURITY: chmod 600.
tls_client_key_password = ""# Passphrase for encrypted client key (empty = unencrypted).
