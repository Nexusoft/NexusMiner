# =============================================================================
# NexusMiner — CPU Prime Solo Mining
# =============================================================================
# Channel: 1 (Prime)  Hardware: CPU  Mode: Solo
#
# Prime mining uses CPU workers running the sieve + Fermat test algorithm.
# Each [workers] count spawns one independent worker thread group.
#
# REQUIRED: Fill in genesis, reward_address, and both Falcon keys before running.
# =============================================================================

[wallet]
ip = "127.0.0.1"           # Your Nexus node IP (localhost = same machine)
port = 8323                 # Legacy mining lane; same port for both channels

[mining]
channel = 1                 # 1 = Prime channel
genesis = "YOUR_GENESIS_HASH_HERE"          # 64-char hex from: system/get/info
reward_address = "YOUR_GENESIS_HASH_HERE"  # 64-char hex genesis hash from system/get/info (same as genesis above; NOT a Base58 account address)

[network]
local_ip = "127.0.0.1"     # Localhost: node is on the same machine
                            # For remote/VPN nodes: change to 0.0.0.0
                            # "auto" also selects a suitable bind address without internet DNS
keepalive_interval = 1      # Session keepalive in hours (1-168)
                            # Production recommendation: 1 hour

[workers]
count = 4                   # Number of prime workers (start with physical core count)
hardware = "cpu"            # CPU workers (default)

[cpu]
threads = 1                 # Threads per worker (1 recommended for prime)
efficiency_cores = true     # Use E-cores on hybrid CPUs (Intel 12th gen+)
hyperthreading = true       # Use SMT/HT threads
priority = 2                # 0=low 1=below_normal 2=normal 3=above_normal 4=high

[stats]
mode = "console"            # File stats mode is not implemented for .config

[logging]
level = 2                   # 0=trace 1=debug 2=info 3=warning

# -----------------------------------------------------------------------------
# [falcon] — Falcon authentication (required for SOLO mining)
# Generate your keypair with: ./NexusMiner --create-keys
# Then add the output pubkey/privkey hex strings below.
# SECURITY: chmod 600 this config file to protect your private key.
# -----------------------------------------------------------------------------
[falcon]
# Generate with: ./NexusMiner --create-keys
pubkey = "YOUR_FALCON_PUBKEY_HEX_HERE"
# Keep secret! chmod 600 this file.
privkey = "YOUR_FALCON_PRIVKEY_HEX_HERE"
# REQUIRED: enables block signing (safe, upstream-compatible)
enable_disposable_falcon = true
