# =============================================================================
# NexusMiner — Remote GPU Hash Mining with TLS
# =============================================================================
# Channel: 2 (Hash)  Hardware: GPU  Mode: Solo  Connection: Remote TLS
#
# Historical reference only: the current mining connection does not use these
# TLS settings and does not establish TLS. Use a secure tunnel for remote
# mining; do not run this template expecting it to encrypt the connection.
#
# For supported setup instructions, see configs/README.md.
# =============================================================================

[wallet]
ip = "YOUR_NODE_IP_OR_HOSTNAME"
port = 8323

[mining]
channel = 2
genesis = "YOUR_GENESIS_HASH_HERE"
reward_address = "YOUR_GENESIS_HASH_HERE"  # 64-char hex genesis hash from system/get/info (same as genesis above; NOT a Base58 account address)

[network]
local_ip = "0.0.0.0"
keepalive_interval = 1

[tls]
enable_tls = true           # Parsed, but not used by the mining connection
ssl_port = 0
tls_ca_cert_path = ""
tls_verify_peer = true
tls_server_name = ""

[workers]
count = 1
hardware = "gpu"

[gpu]
device = 0

[stats]
mode = "console"

[logging]
level = 2

[falcon]
pubkey = "YOUR_FALCON_PUBKEY_HEX_HERE"
privkey = "YOUR_FALCON_PRIVKEY_HEX_HERE"
enable_disposable_falcon = true
