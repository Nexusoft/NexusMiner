# CPU Prime solo mining starter. For NVIDIA GPU Hash instead, copy
# configs/gpu-hash-solo.config. Full setup: configs/README.md.
# Copy this file to miner.config and keep the .config extension.

[wallet]
ip = "127.0.0.1"            # Node on this computer
port = 8323                 # Node mining lane; same port for Prime and Hash

[mining]
channel = 1                 # 1 = Prime, 2 = Hash
genesis = "YOUR_GENESIS_HASH_HERE"
reward_address = "YOUR_GENESIS_HASH_HERE"
# Use the 64-character genesis from system/get/info for both fields.

[network]
local_ip = "127.0.0.1"

[workers]
count = 4                   # Adjust to suit your CPU
hardware = "cpu"

[cpu]
threads = 1                 # Threads per CPU worker

[stats]
mode = "console"

[logging]
level = 2                   # 0=trace, 1=debug, 2=info, 3=warning

[falcon]
# Copy the full public and private hex strings from --create-keys.
pubkey = "YOUR_FALCON_PUBKEY_HEX_HERE"
privkey = "YOUR_FALCON_PRIVKEY_HEX_HERE"
enable_disposable_falcon = true
# Keep the private key secret. Restrict access to this file.
